{
  "manifest_version": 3,
  "name": "Gambitracker",
  "version": "0.6",
  "description": "Suivi de tes mains, coach d'entraînement contre les bots et analyse GTO pour gambit.com.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.gambit.com/*",
    "*://gambit.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.gambit.com/*",
        "*://gambit.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.gambit.com/*",
        "*://gambit.com/*"
      ],
      "js": [
        "config.js",
        "engine.js",
        "relay.js",
        "live.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Gambitracker"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gambitracker@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}